{
  "name": "dsh-permission-matrix",
  "version": "0.3.3",
  "description": "Permission matrix for DeepSeek Harness: 3 sandbox modes x 4 approval strategies = 9 selectable presets, with a global default, a separate LLM-robot default, four-tier risk policies, password-gated approval for high-risk operations, audit log and git checkpoint.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./src/client/index.js"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "permission",
    "permission-preset",
    "sandbox",
    "approval",
    "risk-classifier",
    "auto-approve"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang8019/dsh-permission-matrix.git"
  },
  "homepage": "https://github.com/zhang8019/dsh-permission-matrix#readme",
  "bugs": {
    "url": "https://github.com/zhang8019/dsh-permission-matrix/issues"
  },
  "author": "zhang8019",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/decide.test.js tests/password-approval.test.js tests/hooks.test.js",
    "check": "node --check src/index.js && node --check src/settings.js && node --check src/password-approval.js && node --check src/client/index.js && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1"
  },
  "license": "MIT"
}
